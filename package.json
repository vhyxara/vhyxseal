{
  "name": "vhyxseal",
  "version": "0.0.1",
  "private": true,
  "description": "Seal the contract between your UI and the agentic web",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "pnpm": {
    "overrides": {
      "@vhyxseal/core": "workspace:*",
      "@vhyxseal/react": "workspace:*",
      "@vhyxui/core": "file:.tarballs/vhyxui-core-0.2.0-alpha.tgz",
      "@vhyxui/react": "file:.tarballs/vhyxui-react-0.4.0-alpha.tgz",
      "@vhyxui/tokens": "file:.tarballs/vhyxui-tokens-0.2.0-alpha.tgz",
      "@vhyxui/blocks": "file:.tarballs/vhyxui-blocks-0.1.0-alpha.tgz",
      "@vhyxchart/core": "file:.tarballs/vhyxchart-core-0.1.0-alpha.tgz",
      "@vhyxchart/react": "file:.tarballs/vhyxchart-react-0.1.0-alpha.tgz"
    }
  }
}
