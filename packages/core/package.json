{
  "name": "@vhyxseal/core",
  "version": "1.0.0-rc.6",
  "description": "VhyxSeal core — zero dependency semantic contract layer",
  "keywords": [
    "vhyxseal",
    "ai-agents",
    "agentic-web",
    "contracts",
    "manifest",
    "hmac",
    "security"
  ],
  "license": "MIT",
  "homepage": "https://vhyxseal.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vhyxara/vhyxseal.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/vhyxara/vhyxseal/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.test.json",
    "lint": "eslint src tests"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
