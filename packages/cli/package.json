{
  "name": "@vhyxseal/cli",
  "version": "1.0.0-rc.3",
  "description": "VhyxSeal command line: init, simulate, verify, audit, diff, keygen, sign and visualize agent contracts",
  "keywords": [
    "vhyxseal",
    "ai-agents",
    "agentic-web",
    "cli",
    "manifest",
    "signing"
  ],
  "license": "MIT",
  "homepage": "https://vhyxseal.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vhyxara/vhyxseal.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/vhyxara/vhyxseal/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "bin": {
    "vhyxseal": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./visualize": {
      "types": "./dist/visualize/index.d.ts",
      "import": "./dist/visualize/index.js",
      "default": "./dist/visualize/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "@vhyxseal/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
