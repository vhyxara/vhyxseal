{
  "name": "@vhyxseal/vanilla",
  "version": "1.0.0-rc.3",
  "description": "Framework-free VhyxSeal custom elements (<seal-button>, <seal-form> …), safe to import during SSR",
  "keywords": [
    "vhyxseal",
    "ai-agents",
    "agentic-web",
    "web-components",
    "custom-elements"
  ],
  "license": "MIT",
  "homepage": "https://vhyxseal.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vhyxara/vhyxseal.git",
    "directory": "packages/vanilla"
  },
  "bugs": {
    "url": "https://github.com/vhyxara/vhyxseal/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "@vhyxseal/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
